# Telegram (@BotFather)
TELEGRAM_BOT_TOKEN=123456:ABC...
# Cualquier string largo random (lo valida el webhook)
# TELEGRAM_WEBHOOK_SECRET=  (opcional: si no está, se deriva del token)
# Tu chat id (si no lo sabés, escribile al bot y te lo dice). Varios separados por coma.
ALLOWED_CHAT_IDS=123456789

# Supabase → Project Settings → API
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# Google AI Studio → Get API key
GEMINI_API_KEY=AIza...
# Opcional: fijá un modelo concreto (ej: gemini-3.5-flash). Por defecto usa el alias del último Flash.
# GEMINI_MODEL=gemini-3.8-flash  (opcional: por defecto prueba 3.8 → 3.6 → 3.5 Flash)

# Vercel Cron manda "Authorization: Bearer $CRON_SECRET"
CRON_SECRET=otro-string-random
